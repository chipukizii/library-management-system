{
  "info": {
    "_postman_id": "a548231c-3b91-4d32-8419-7988357a8291",
    "name": "Library Management System API",
    "description": "Complete Postman v2.1 collection for Library Management System: Auth (JWT + bcrypt), Roles & Guards (LIBRARIAN, MEMBER, PATRON), Genres CRUD, Books CRUD, Case-Insensitive Search, Genre Filtering, Pagination, and Unauthorized/Forbidden Guard Verifications.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "librarian_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "patron_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "genre_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "book_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register - Librarian",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"head_librarian@library.org\",\n  \"name\": \"Head Librarian\",\n  \"password\": \"librarianPass123!\",\n  \"role\": \"LIBRARIAN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Register an administrative librarian account with bcrypt password hashing."
          }
        },
        {
          "name": "Register - Member / Patron",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"member_patron@library.org\",\n  \"name\": \"Jane Patron\",\n  \"password\": \"patronPass123!\",\n  \"role\": \"MEMBER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Register a new patron/member account defaulting or set to MEMBER/PATRON."
          }
        },
        {
          "name": "Login - Librarian",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.access_token) {",
                  "  pm.collectionVariables.set('librarian_token', response.access_token);",
                  "  pm.collectionVariables.set('token', response.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"head_librarian@library.org\",\n  \"password\": \"librarianPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login as librarian to obtain JWT access token with role LIBRARIAN."
          }
        },
        {
          "name": "Login - Member / Patron",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.access_token) {",
                  "  pm.collectionVariables.set('patron_token', response.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"member_patron@library.org\",\n  \"password\": \"patronPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login as patron/member to obtain JWT access token."
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Create Genre (Librarian Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.id) {",
                  "  pm.collectionVariables.set('genre_id', response.id.toString());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarian_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cyberpunk Fiction\",\n  \"description\": \"Subgenre of science fiction in a dystopian futuristic setting\",\n  \"slug\": \"cyberpunk-fiction\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/genres",
              "host": ["{{baseUrl}}"],
              "path": ["genres"]
            },
            "description": "Create a new genre category with validated DTO. Protected by JwtAuthGuard and RolesGuard(Role.LIBRARIAN)."
          }
        },
        {
          "name": "Get All Genres (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/genres",
              "host": ["{{baseUrl}}"],
              "path": ["genres"]
            },
            "description": "Public endpoint to retrieve all genres along with book counts (_count: { books: true })."
          }
        },
        {
          "name": "Get Genre By ID (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/genres/{{genre_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["genres", "{{genre_id}}"]
            },
            "description": "Public endpoint to retrieve a single genre by ID with related books. Returns 404 if not found."
          }
        },
        {
          "name": "Update Genre (Librarian Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarian_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cyberpunk & High Tech\",\n  \"description\": \"Updated futuristic high-tech dystopian genre\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/genres/{{genre_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["genres", "{{genre_id}}"]
            },
            "description": "Update an existing genre. Protected by JwtAuthGuard and RolesGuard(Role.LIBRARIAN)."
          }
        },
        {
          "name": "Delete Genre (Librarian Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarian_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/genres/{{genre_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["genres", "{{genre_id}}"]
            },
            "description": "Delete a genre category by ID. Protected by JwtAuthGuard and RolesGuard(Role.LIBRARIAN)."
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Create Book (Librarian Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.id) {",
                  "  pm.collectionVariables.set('book_id', response.id.toString());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarian_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Snow Crash\",\n  \"author\": \"Neal Stephenson\",\n  \"isbn\": \"9780553380958\",\n  \"description\": \"In reality, Hiro Protagonist delivers pizza for Uncle Enzo's CosoNostra Pizza Inc., but in the Metaverse he is a warrior prince.\",\n  \"publishedYear\": 1992,\n  \"coverImage\": \"https://images.example.com/snow-crash.jpg\",\n  \"totalCopies\": 4,\n  \"availableCopies\": 4,\n  \"genreId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            },
            "description": "Create a new book in catalog. Guarded by JwtAuthGuard and RolesGuard(Role.LIBRARIAN)."
          }
        },
        {
          "name": "Get All Books - Default",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            },
            "description": "Public endpoint retrieving paginated books with { data, meta: { total, page, limit, totalPages } }."
          }
        },
        {
          "name": "Get All Books - Pagination",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?page=1&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Read paginated books using page and limit query params."
          }
        },
        {
          "name": "Get All Books - Search (Title, Author, ISBN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search=Tolkien",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "search",
                  "value": "Tolkien"
                }
              ]
            },
            "description": "Case-insensitive search across title, author, and isbn."
          }
        },
        {
          "name": "Get All Books - Filter by Genre",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?genreId=1",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "genreId",
                  "value": "1"
                }
              ]
            },
            "description": "Filter books matching specific genreId."
          }
        },
        {
          "name": "Get All Books - Filter, Search & Pagination",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?genreId=1&search=Hobbit&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "genreId",
                  "value": "1"
                },
                {
                  "key": "search",
                  "value": "Hobbit"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Combined query with genreId filtering, title/author/isbn search, and pagination."
          }
        },
        {
          "name": "Get Book By ID (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{book_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{book_id}}"]
            },
            "description": "Public endpoint retrieving single book details including genre relation. Returns 404 if missing."
          }
        },
        {
          "name": "Update Book (Librarian Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarian_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalCopies\": 8,\n  \"availableCopies\": 8\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/{{book_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{book_id}}"]
            },
            "description": "Update book attributes. Guarded by JwtAuthGuard and RolesGuard(Role.LIBRARIAN)."
          }
        },
        {
          "name": "Delete Book (Librarian Only)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarian_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/{{book_id}}",
              "host": ["{{baseUrl}}"],
              "path": ["books", "{{book_id}}"]
            },
            "description": "Delete a book record from catalog. Guarded by JwtAuthGuard and RolesGuard(Role.LIBRARIAN)."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{librarian_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            },
            "description": "Read authenticated user profile via JWT token."
          }
        }
      ]
    },
    {
      "name": "Role Guards & Security Tests",
      "item": [
        {
          "name": "Create Book - Unauthorized (Missing Token -> 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Unauthorized Book\",\n  \"author\": \"Hacker\",\n  \"isbn\": \"9789999999999\",\n  \"totalCopies\": 1,\n  \"genreId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            },
            "description": "Asserts 401 Unauthorized when attempting to create a book without a Bearer token."
          }
        },
        {
          "name": "Create Book - Forbidden (Member Token -> 403)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{patron_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Forbidden Book\",\n  \"author\": \"Member\",\n  \"isbn\": \"9788888888888\",\n  \"totalCopies\": 1,\n  \"genreId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            },
            "description": "Asserts 403 Forbidden when a user with role MEMBER/PATRON attempts to create a book."
          }
        },
        {
          "name": "Create Genre - Unauthorized (Missing Token -> 401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Unauthorized Genre\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/genres",
              "host": ["{{baseUrl}}"],
              "path": ["genres"]
            },
            "description": "Asserts 401 Unauthorized when attempting to create a genre without a Bearer token."
          }
        },
        {
          "name": "Create Genre - Forbidden (Member Token -> 403)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{patron_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Forbidden Genre\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/genres",
              "host": ["{{baseUrl}}"],
              "path": ["genres"]
            },
            "description": "Asserts 403 Forbidden when a non-librarian member tries to create a genre."
          }
        }
      ]
    }
  ]
}
